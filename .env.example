# Server Port
PORT=5000

# MongoDB Connection String (Cloud Atlas or Local)
# VD Cloud Atlas: mongodb+srv://username:password@cluster.mongodb.net/eduteacher_db
# VD Local: mongodb://localhost:27017/eduteacher_db
MONGODB_URI=mongodb://localhost:27017/eduteacher_db

# Telegram Bot Integration
# Lấy BOT_TOKEN từ Telegram @BotFather
TELEGRAM_BOT_TOKEN=7890123456:AAFx_YourTelegramBotTokenHere
# Chat ID cá nhân hoặc ID Group/Channel nhận thông báo
TELEGRAM_CHAT_ID=-1001234567890

# Google Sheets Webhook / Apps Script Integration URL
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbx_YourGoogleAppsScriptDeploymentId/exec
